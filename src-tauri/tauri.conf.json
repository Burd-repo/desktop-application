{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "burd-app",
  "version": "0.1.0",
  "identifier": "ai.burd.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Burd",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "resources": ["binaries/"]
  }
}
