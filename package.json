{
  "name": "burd-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Burd desktop/local app built with Tauri, React and Tailwind CSS.",
  "scripts": {
    "dev": "vite",
    "sync:agent": "powershell -ExecutionPolicy Bypass -File scripts/sync-burd-agent.ps1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "tauri:build:with-agent": "npm run sync:agent && npm run tauri build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-http": "^2.0.0",
    "lucide-react": "^0.542.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
